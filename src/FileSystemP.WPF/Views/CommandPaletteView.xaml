<UserControl x:Class="FileSystemP.WPF.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FileSystemP.WPF.Views"
             xmlns:viewmodels="clr-namespace:FileSystemP.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CommandPaletteViewModel}"
             Background="#1E1E1E"
             FontFamily="Consolas"
             FontSize="13">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="HistoryScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding OutputHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Prompt}" Foreground="Green" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="InputBox" Grid.Column="1" 
                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     CaretBrush="White"
                     VerticalAlignment="Center"
                     KeyDown="InputBox_KeyDown">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ExecuteCommandCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </Grid>
    </Grid>
</UserControl>
