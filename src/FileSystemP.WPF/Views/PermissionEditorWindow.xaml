<Window x:Class="FileSystemP.WPF.Views.PermissionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Permissions"
        Width="500"
        Height="600"
        MinWidth="460"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{DynamicResource AppForeground}" Text="Group or user names:"/>
        
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" Height="120" ItemsSource="{Binding Identities}" SelectedItem="{Binding SelectedIdentity}" DisplayMemberPath="Name" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AppForeground}" BorderBrush="{DynamicResource AppMuted}"/>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Content="Add..." Margin="0,0,0,4" Width="80" Padding="0,4" Click="Add_Click"/>
                <Button Content="Remove" Width="80" Padding="0,4" Click="Remove_Click" IsEnabled="{Binding CanRemoveSelected}"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,0,0,8" Foreground="{DynamicResource AppForeground}" FontWeight="Bold" Text="{Binding SelectedIdentity.Name, StringFormat='Permissions for {0}'}"/>

        <Border Grid.Row="3" Margin="0,0,0,12" BorderBrush="{DynamicResource AppMuted}" BorderThickness="1" Padding="8" Background="{DynamicResource AppSurface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Control" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" Margin="0,4"/>
                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding IsFullControlSelected}" IsEnabled="{Binding IsFullControlEnabled}" Margin="0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Read" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" Margin="0,4"/>
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding IsReadSelected}" IsEnabled="{Binding IsReadEnabled}" Margin="0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Write" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" Margin="0,4"/>
                <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding IsWriteSelected}" IsEnabled="{Binding IsWriteEnabled}" Margin="0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Execute" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" Margin="0,4"/>
                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding IsExecuteSelected}" IsEnabled="{Binding IsExecuteEnabled}" Margin="0,4"/>
            </Grid>
        </Border>

        <CheckBox Grid.Row="4" Content="Include inheritable permissions from this object's parent" IsChecked="{Binding IsInheritanceProtected}" Margin="0,0,0,12" Foreground="{DynamicResource AppForeground}"/>

        <Border Grid.Row="5" Padding="0,12,0,0" BorderBrush="{DynamicResource AppMuted}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Width="88" Margin="8,0,0,0" Padding="0,6" IsDefault="True" Click="Ok_Click" Content="OK"/>
                <Button DockPanel.Dock="Right" Width="88" Margin="8,0,0,0" Padding="0,6" Click="Apply_Click" Content="Apply"/>
                <Button DockPanel.Dock="Right" Width="88" Padding="0,6" IsCancel="True" Content="Cancel"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
