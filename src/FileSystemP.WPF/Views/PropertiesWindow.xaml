<Window x:Class="FileSystemP.WPF.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties"
        Width="560"
        Height="680"
        MinWidth="540"
        MinHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Background="{DynamicResource AppBackground}"
                    BorderBrush="{DynamicResource AppMuted}">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Background="{DynamicResource AppSurface}"
                                    BorderBrush="{DynamicResource AppMuted}"
                                    BorderThickness="1">
                                <Image Source="{Binding Icon}"
                                       Width="24"
                                       Height="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppForeground}"/>
                                <TextBlock Text="{Binding Type}"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource AppMuted}"/>
                            </StackPanel>
                        </Grid>

                        <GroupBox Grid.Row="1"
                                  Margin="0,0,0,12"
                                  Header="Type"
                                  Foreground="{DynamicResource AppForeground}">
                            <Grid Margin="10,8,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" Text="Name:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Name}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" Text="Type:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Type}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" Text="Location:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Location}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2"
                                  Margin="0,0,0,12"
                                  Header="Size"
                                  Foreground="{DynamicResource AppForeground}">
                            <Grid Margin="10,8,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" Text="Size:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Size}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Text="Path:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TargetPath}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="3"
                                  Margin="0,0,0,12"
                                  Header="Dates"
                                  Foreground="{DynamicResource AppForeground}">
                            <Grid Margin="10,8,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" Text="Created:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding CreatedAt}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" Text="Modified:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ModifiedAt}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" Text="Accessed:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccessedAt}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="4"
                                  Margin="0,0,0,12"
                                  Header="Attributes"
                                  Foreground="{DynamicResource AppForeground}">
                            <Grid Margin="10,8,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsReadOnly}"
                                              Margin="0,0,18,0"
                                              Foreground="{DynamicResource AppForeground}"
                                              Content="{Binding ReadOnlyLabel}"/>
                                    <CheckBox IsChecked="{Binding IsHidden}"
                                              Foreground="{DynamicResource AppForeground}"
                                              Content="Hidden"/>
                                </StackPanel>

                                <CheckBox Grid.Row="1"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Margin="0,10,0,0"
                                          Visibility="{Binding SupportsRecursiveAttributeChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          IsChecked="{Binding ApplyChangesRecursively}"
                                          Foreground="{DynamicResource AppForeground}"
                                          Content="Apply attribute changes to this folder, subfolders, and files"/>

                                <Button Grid.Row="2"
                                        Grid.Column="1"
                                        Width="96"
                                        Margin="8,12,0,0"
                                        Padding="0,6"
                                        HorizontalAlignment="Right"
                                        Click="Advanced_Click"
                                        Content="Advanced..."/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="5"
                                  Margin="0,0,0,8"
                                  Header="File system"
                                  Foreground="{DynamicResource AppForeground}">
                            <Grid Margin="10,8,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" Text="Parent:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ParentPath}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Text="Root:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RootPath}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Details" IsEnabled="False">
                <Grid Background="{DynamicResource AppBackground}">
                    <TextBlock Text="Details tab will be implemented next."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMuted}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Security">
                <Grid Margin="12" DataContext="{Binding Security}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Object Name" FontWeight="Bold" Foreground="{DynamicResource AppForeground}"/>
                        <TextBlock Text="{Binding DataContext.TargetPath, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Owner" FontWeight="Bold" Foreground="{DynamicResource AppForeground}"/>
                        <TextBlock Text="{Binding Owner}" Foreground="{DynamicResource AppForeground}"/>
                    </StackPanel>
                    
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Permissions}" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="{DynamicResource AppBackground}" 
                              BorderBrush="{DynamicResource AppMuted}" 
                              Foreground="{DynamicResource AppForeground}"
                              RowBackground="{DynamicResource AppBackground}"
                              AlternatingRowBackground="{DynamicResource AppSurface}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User/Group" Binding="{Binding Identity}" Width="*"/>
                            <DataGridTextColumn Header="Windows" Binding="{Binding WindowsRights}" Width="*"/>
                            <DataGridTextColumn Header="rwx" Binding="{Binding LinuxRights}" Width="60"/>
                            <DataGridCheckBoxColumn Header="Inherited" Binding="{Binding IsInherited, Mode=OneWay}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource AppMuted}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource AppMuted}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="{Binding BusyStatusText}" />
                <Button DockPanel.Dock="Right"
                        Width="88"
                        Padding="0,6"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        IsEnabled="{Binding CanCloseDialog}"
                        Click="Ok_Click"
                        Content="OK"/>
                <Button DockPanel.Dock="Right"
                        Width="88"
                        Padding="0,6"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding CanApplyChanges}"
                        Click="Apply_Click"
                        Content="Apply"/>
                <Button DockPanel.Dock="Right"
                        Width="88"
                        Padding="0,6"
                        IsEnabled="{Binding CanCloseDialog}"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Content="Cancel"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
