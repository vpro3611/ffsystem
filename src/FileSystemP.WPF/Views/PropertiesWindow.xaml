<Window x:Class="FileSystemP.WPF.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties"
        Width="520"
        Height="620"
        MinWidth="500"
        MinHeight="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Background="{DynamicResource AppBackground}"
                    BorderBrush="{DynamicResource AppMuted}">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Background="{DynamicResource AppSurface}"
                                    BorderBrush="{DynamicResource AppMuted}"
                                    BorderThickness="1">
                                <Image Source="{Binding Icon}"
                                       Width="24"
                                       Height="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppForeground}"/>
                                <TextBlock Text="{Binding Type}"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource AppMuted}"/>
                            </StackPanel>
                        </Grid>

                        <GroupBox Grid.Row="1"
                                  Margin="0,0,0,12"
                                  Header="Type"
                                  Foreground="{DynamicResource AppForeground}">
                            <Grid Margin="10,8,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" Text="Name:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Name}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" Text="Type:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Type}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" Text="Location:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Location}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2"
                                  Margin="0,0,0,12"
                                  Header="Size"
                                  Foreground="{DynamicResource AppForeground}">
                            <Grid Margin="10,8,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" Text="Size:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Size}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Text="Path:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TargetPath}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="3"
                                  Margin="0,0,0,12"
                                  Header="Dates"
                                  Foreground="{DynamicResource AppForeground}">
                            <Grid Margin="10,8,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" Text="Created:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding CreatedAt}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" Text="Modified:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ModifiedAt}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" Text="Accessed:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccessedAt}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="4"
                                  Margin="0,0,0,12"
                                  Header="Attributes"
                                  Foreground="{DynamicResource AppForeground}">
                            <StackPanel Orientation="Horizontal" Margin="10,8,10,10">
                                <CheckBox IsChecked="{Binding IsReadOnly}"
                                          IsEnabled="False"
                                          Margin="0,0,18,0"
                                          Foreground="{DynamicResource AppForeground}"
                                          Content="Read-only"/>
                                <CheckBox IsChecked="{Binding IsHidden}"
                                          IsEnabled="False"
                                          Foreground="{DynamicResource AppForeground}"
                                          Content="Hidden"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="5"
                                  Margin="0,0,0,8"
                                  Header="File system"
                                  Foreground="{DynamicResource AppForeground}">
                            <Grid Margin="10,8,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" Text="Parent:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ParentPath}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Text="Root:" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RootPath}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Details" IsEnabled="False">
                <Grid Background="{DynamicResource AppBackground}">
                    <TextBlock Text="Details tab will be implemented next."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMuted}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Security" IsEnabled="False">
                <Grid Background="{DynamicResource AppBackground}">
                    <TextBlock Text="Security tab will be implemented next."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMuted}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource AppMuted}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Width="88"
                        Padding="0,6"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Click="Close_Click"
                        Content="OK"/>
                <Button DockPanel.Dock="Right"
                        Width="88"
                        Padding="0,6"
                        IsCancel="True"
                        Click="Close_Click"
                        Content="Cancel"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
