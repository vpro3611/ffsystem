<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="AppSurface" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="AppForeground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="AppMuted" Color="#666666"/>
    <!-- Override system selection colors so selected items are visible in dark mode -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2C5F9E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#CCCCCC"/>
</ResourceDictionary>
