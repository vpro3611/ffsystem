<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="AppMuted" Color="#999999"/>
    <!-- Override system selection colors for light mode -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A1A1A"/>
</ResourceDictionary>
