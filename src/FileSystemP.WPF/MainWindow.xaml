<Window x:Class="FileSystemP.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileSystemP" Height="600" Width="900"
        Background="{DynamicResource AppBackground}">
    <Window.Resources>
        <!-- File context menu -->
        <ContextMenu x:Key="FileMenu">
            <MenuItem Header="Open"       Command="{Binding DataContext.Panel.OpenCommand,   RelativeSource={RelativeSource AncestorType=Window}}"/>
            <MenuItem Header="Rename"     Command="{Binding DataContext.Panel.RenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <MenuItem Header="Copy"       Command="{Binding DataContext.Panel.CopyCommand,   RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Separator/>
            <MenuItem Header="Delete"     Command="{Binding DataContext.Panel.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </ContextMenu>

        <!-- Folder context menu -->
        <ContextMenu x:Key="FolderMenu">
            <MenuItem Header="Open"       Command="{Binding DataContext.Panel.OpenCommand,   RelativeSource={RelativeSource AncestorType=Window}}"/>
            <MenuItem Header="Rename"     Command="{Binding DataContext.Panel.RenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <MenuItem Header="Copy"       Command="{Binding DataContext.Panel.CopyCommand,   RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Separator/>
            <MenuItem Header="Delete"     Command="{Binding DataContext.Panel.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Separator/>
            <MenuItem Header="New File"   Command="{Binding DataContext.Panel.NewFileCommand,   RelativeSource={RelativeSource AncestorType=Window}}"/>
            <MenuItem Header="New Folder" Command="{Binding DataContext.Panel.NewFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </ContextMenu>

        <!-- Empty space context menu -->
        <ContextMenu x:Key="EmptySpaceMenu">
            <MenuItem Header="Paste"      Command="{Binding DataContext.Panel.PasteCommand,     RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Separator/>
            <MenuItem Header="New File"   Command="{Binding DataContext.Panel.NewFileCommand,   RelativeSource={RelativeSource AncestorType=Window}}"/>
            <MenuItem Header="New Folder" Command="{Binding DataContext.Panel.NewFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="120"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Tree panel -->
        <Border Grid.Column="0" Background="{DynamicResource AppSurface}">
            <TreeView x:Name="FileTree"
                      ItemsSource="{Binding Tree.Roots}"
                      Background="Transparent"
                      Foreground="{DynamicResource AppForeground}"
                      BorderThickness="0"
                      SelectedItemChanged="FileTree_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppForeground}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource AppSurface}"/>

        <!-- Right: File panel -->
        <Grid Grid.Column="2" Background="{DynamicResource AppBackground}">
            <!-- ListView -->
            <ListView x:Name="FileList"
                      ItemsSource="{Binding Panel.Entries}"
                      SelectedItem="{Binding Panel.SelectedEntry, Mode=TwoWay}"
                      Background="Transparent"
                      Foreground="{DynamicResource AppForeground}"
                      BorderThickness="0"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      ContextMenu="{StaticResource EmptySpaceMenu}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="24">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="16" Height="16"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Name"          Width="240" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Type"          Width="120" DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn Header="Size"          Width="80"  DisplayMemberBinding="{Binding Size}"/>
                        <GridViewColumn Header="Date Modified" Width="140" DisplayMemberBinding="{Binding DateModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                <Setter Property="ContextMenu" Value="{StaticResource FolderMenu}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                <Setter Property="ContextMenu" Value="{StaticResource FileMenu}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Empty state overlay -->
            <TextBlock Text="This folder is empty"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMuted}"
                       FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Panel.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Error state overlay -->
            <TextBlock Text="{Binding Panel.ErrorMessage}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMuted}"
                       FontSize="13" TextWrapping="Wrap" MaxWidth="400">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Panel.ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
