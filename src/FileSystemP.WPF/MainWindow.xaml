<Window x:Class="FileSystemP.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileSystemP" Height="600" Width="900"
        Background="{DynamicResource AppBackground}">
    <Window.Resources>
        <!-- File context menu — PlacementTarget is ListViewItem; Tag holds MainWindowViewModel via ListView.DataContext -->
        <ContextMenu x:Key="FileMenu">
            <MenuItem Header="Open"       Command="{Binding PlacementTarget.Tag.Panel.OpenCommand,   RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Rename"     Command="{Binding PlacementTarget.Tag.Panel.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Copy"       Command="{Binding PlacementTarget.Tag.Panel.CopyCommand,   RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Delete"     Command="{Binding PlacementTarget.Tag.Panel.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Properties" Command="{Binding PlacementTarget.Tag.Panel.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <!-- Folder context menu -->
        <ContextMenu x:Key="FolderMenu">
            <MenuItem Header="Open"       Command="{Binding PlacementTarget.Tag.Panel.OpenCommand,   RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Rename"     Command="{Binding PlacementTarget.Tag.Panel.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Copy"       Command="{Binding PlacementTarget.Tag.Panel.CopyCommand,   RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Delete"     Command="{Binding PlacementTarget.Tag.Panel.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="New File"              Command="{Binding PlacementTarget.Tag.Panel.NewFileCommand,              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="New File with Content" Command="{Binding PlacementTarget.Tag.Panel.NewFileWithContentCommand,  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="New Folder"            Command="{Binding PlacementTarget.Tag.Panel.NewFolderCommand,           RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Properties"            Command="{Binding PlacementTarget.Tag.Panel.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <ContextMenu x:Key="TreeFolderMenu">
            <MenuItem Header="Properties"
                      Command="{Binding PlacementTarget.Tag.ShowTreeNodePropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <!-- Toolbar button style: transparent background, invisible when disabled -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BreadcrumbButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppMuted}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <x:Array x:Key="SearchTargetTypes" Type="local:SearchTargetType"
                 xmlns:local="clr-namespace:FileSystemP.Core.SearchService.Options;assembly=FileSystemP.Core">
            <local:SearchTargetType>Both</local:SearchTargetType>
            <local:SearchTargetType>Files</local:SearchTargetType>
            <local:SearchTargetType>Directories</local:SearchTargetType>
        </x:Array>

        <!-- Empty space context menu — PlacementTarget is ListView whose DataContext IS MainWindowViewModel -->
        <ContextMenu x:Key="EmptySpaceMenu">
            <MenuItem Header="Paste"                 Command="{Binding PlacementTarget.DataContext.Panel.PasteCommand,            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="New File"              Command="{Binding PlacementTarget.DataContext.Panel.NewFileCommand,           RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="New File with Content" Command="{Binding PlacementTarget.DataContext.Panel.NewFileWithContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="New Folder"            Command="{Binding PlacementTarget.DataContext.Panel.NewFolderCommand,         RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Path bar -->
        <ItemsControl Grid.Row="0"
                      ItemsSource="{Binding PathSegments}"
                      Background="{DynamicResource AppSurface}"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource AppMuted}"
                      Padding="10,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding Name}"
                                Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding FullPath}"
                                Style="{StaticResource BreadcrumbButtonStyle}"
                                FontFamily="Consolas"
                                FontSize="13"/>
                        <TextBlock Text="\" 
                                   Foreground="{DynamicResource AppMuted}" 
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   Margin="2,0"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Toolbar row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    Background="{DynamicResource AppSurface}" Height="34">
            <Button Content="←" Command="{Binding NavigateBackCommand}"
                    Style="{StaticResource ToolbarButton}" Padding="10,4" FontSize="14" ToolTip="Back"/>
            <Button Content="→" Command="{Binding NavigateForwardCommand}"
                    Style="{StaticResource ToolbarButton}" Padding="10,4" FontSize="14" ToolTip="Forward"/>
            <Separator Width="1" Margin="4,6" Background="{DynamicResource AppMuted}"/>
            <Button Content="↩ Undo" Command="{Binding Panel.UndoCommand}"
                    Style="{StaticResource ToolbarButton}" Padding="10,4" FontSize="12" ToolTip="Undo last action"/>
            <Separator Width="1" Margin="4,6" Background="{DynamicResource AppMuted}"/>
            <Button Content="🔍 Search" Command="{Binding Search.ToggleVisibilityCommand}"
                    Style="{StaticResource ToolbarButton}" Padding="10,4" FontSize="12" ToolTip="Toggle Search Panel"/>
        </StackPanel>

        <!-- Search Panel -->
        <Border Grid.Row="2" Background="{DynamicResource AppSurface}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppMuted}"
                Visibility="{Binding Search.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Padding="10" Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Text="{Binding Search.Pattern, UpdateSourceTrigger=PropertyChanged}" 
                             Foreground="{DynamicResource AppForeground}" Background="Transparent" BorderThickness="0,0,0,1" Margin="0,0,10,0"
                             Padding="2,4" VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                                </Border>
                                                <TextBlock x:Name="placeholder" Text="Search Pattern..." Foreground="{DynamicResource AppMuted}" Padding="{TemplateBinding Padding}" Visibility="Collapsed" IsHitTestVisible="False"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding Search.TargetType}" ItemsSource="{Binding Source={StaticResource SearchTargetTypes}}" Width="100" Margin="0,0,10,0"
                              VerticalContentAlignment="Center" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AppForeground}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Search" Command="{Binding Search.StartSearchCommand}" CommandParameter="{Binding CurrentPath}" Style="{StaticResource ToolbarButton}" Padding="12,4" Background="{DynamicResource AppSelection}"/>
                        <Button Content="Cancel" Command="{Binding Search.CancelSearchCommand}" Style="{StaticResource ToolbarButton}" Padding="12,4" Margin="4,0,0,0" Visibility="{Binding Search.IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
                
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox Content="Recursive" IsChecked="{Binding Search.Recursive}" Foreground="{DynamicResource AppForeground}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Size (MB) >" Foreground="{DynamicResource AppMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Search.AboveSize}" Width="50" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource AppForeground}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppMuted}"/>
                    <TextBlock Text="Created From" Foreground="{DynamicResource AppMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding Search.CreatedFrom}" Width="110" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Two-column split grid -->
        <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="120"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Tree panel -->
        <Border Grid.Column="0" Background="{DynamicResource AppSurface}">
            <TreeView x:Name="FileTree"
                      ItemsSource="{Binding Tree.Roots}"
                      Background="Transparent"
                      Foreground="{DynamicResource AppForeground}"
                      BorderThickness="0"
                      SelectedItemChanged="FileTree_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppForeground}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="4,3"/>
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                        <Setter Property="ContextMenu" Value="{StaticResource TreeFolderMenu}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource AppSurface}"/>

        <!-- Right: File panel -->
        <Grid Grid.Column="2" Background="{DynamicResource AppBackground}">
            <!-- ListView -->
            <ListView x:Name="FileList"
                      ItemsSource="{Binding Panel.Entries}"
                      SelectedItem="{Binding Panel.SelectedEntry, Mode=TwoWay}"
                      Background="Transparent"
                      Foreground="{DynamicResource AppForeground}"
                      BorderThickness="0"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                      ContextMenu="{StaticResource EmptySpaceMenu}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="24">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="16" Height="16"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Name"          Width="240" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Type"          Width="120" DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn Header="Size"          Width="80"  DisplayMemberBinding="{Binding Size}"/>
                        <GridViewColumn Header="Date Modified" Width="140" DisplayMemberBinding="{Binding DateModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Tag"        Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="2,2" SnapsToDevicePixels="True">
                                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                              Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSelection}"/>
                                            <Setter Property="Foreground"                  Value="{DynamicResource AppSelectionText}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected"           Value="True"/>
                                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSelectionInactive}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                <Setter Property="ContextMenu" Value="{StaticResource FolderMenu}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                <Setter Property="ContextMenu" Value="{StaticResource FileMenu}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Empty state overlay -->
            <TextBlock Text="This folder is empty"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMuted}"
                       FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Panel.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Error state overlay -->
            <TextBlock Text="{Binding Panel.ErrorMessage}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMuted}"
                       FontSize="13" TextWrapping="Wrap" MaxWidth="400">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Panel.ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        </Grid>
    </Grid>
</Window>
