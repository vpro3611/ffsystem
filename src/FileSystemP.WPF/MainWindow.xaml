<Window x:Class="FileSystemP.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileSystemP.Core.SearchService.Options;assembly=FileSystemP.Core"
        xmlns:localViews="clr-namespace:FileSystemP.WPF.Views"
        Title="FileSystemP" Height="600" Width="900"
        Background="{DynamicResource AppBackground}">
    <Window.Resources>
        <ContextMenu x:Key="FileMenu">
            <MenuItem Header="Open" Command="{Binding PlacementTarget.Tag.Panel.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Rename" Command="{Binding PlacementTarget.Tag.Panel.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Copy" Command="{Binding PlacementTarget.Tag.Panel.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.Panel.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Properties" Command="{Binding PlacementTarget.Tag.Panel.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <ContextMenu x:Key="FolderMenu">
            <MenuItem Header="Open" Command="{Binding PlacementTarget.Tag.Panel.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Rename" Command="{Binding PlacementTarget.Tag.Panel.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Copy" Command="{Binding PlacementTarget.Tag.Panel.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.Panel.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="New File" Command="{Binding PlacementTarget.Tag.Panel.NewFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="New File with Content" Command="{Binding PlacementTarget.Tag.Panel.NewFileWithContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="New Folder" Command="{Binding PlacementTarget.Tag.Panel.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Properties" Command="{Binding PlacementTarget.Tag.Panel.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <Style x:Key="SidebarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AppForeground}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
                        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppSelection}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppSelectionText}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource AppSurface}">
                                        <Path HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{TemplateBinding Foreground}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource AppSurface}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AppSelection}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <x:Array x:Key="SearchTargetTypes" Type="local:SearchTargetType">
            <local:SearchTargetType>Both</local:SearchTargetType>
            <local:SearchTargetType>Files</local:SearchTargetType>
            <local:SearchTargetType>Directories</local:SearchTargetType>
        </x:Array>

        <x:Array x:Key="SearchNameModes" Type="local:NameSearchMode">
            <local:NameSearchMode>Contains</local:NameSearchMode>
            <local:NameSearchMode>Exact</local:NameSearchMode>
            <local:NameSearchMode>Pattern</local:NameSearchMode>
        </x:Array>

        <ContextMenu x:Key="EmptySpaceMenu">
            <MenuItem Header="Paste" Command="{Binding PlacementTarget.DataContext.Panel.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="New File" Command="{Binding PlacementTarget.DataContext.Panel.NewFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="New File with Content" Command="{Binding PlacementTarget.DataContext.Panel.NewFileWithContentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="New Folder" Command="{Binding PlacementTarget.DataContext.Panel.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <ContextMenu x:Key="TreeFolderMenu">
            <MenuItem Header="Properties"
                      Command="{Binding PlacementTarget.Tag.ShowTreeNodePropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BreadcrumbButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppMuted}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto">
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="Auto"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Palette.IsVisible}" Value="True"/>
                                    <Condition Binding="{Binding IsTerminalDetached}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Height" Value="200"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>

        <!-- Breadcrumbs -->
        <ItemsControl Grid.Row="0"
                      ItemsSource="{Binding PathSegments}"
                      Background="{DynamicResource AppSurface}"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource AppMuted}"
                      Padding="10,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding Name}"
                                Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding FullPath}"
                                Style="{StaticResource BreadcrumbButtonStyle}"
                                FontFamily="Consolas"
                                FontSize="13"/>
                        <TextBlock Text="\"
                                   Foreground="{DynamicResource AppMuted}"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   Margin="2,0"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="{DynamicResource AppSurface}" Height="34">
            <Button Content="←" Command="{Binding NavigateBackCommand}" Style="{StaticResource ToolbarButton}" Padding="10,4" FontSize="14" ToolTip="Back"/>
            <Button Content="→" Command="{Binding NavigateForwardCommand}" Style="{StaticResource ToolbarButton}" Padding="10,4" FontSize="14" ToolTip="Forward"/>
            <Separator Width="1" Margin="4,6" Background="{DynamicResource AppMuted}"/>
            <Button Content="↩ Undo" Command="{Binding Panel.UndoCommand}" Style="{StaticResource ToolbarButton}" Padding="10,4" FontSize="12" ToolTip="Undo last action"/>
            <Separator Width="1" Margin="4,6" Background="{DynamicResource AppMuted}"/>
            <Button Content="Search" Command="{Binding ShowSearchMenuCommand}" Style="{StaticResource ToolbarButton}" Padding="10,4" FontSize="12" ToolTip="Open search menu"/>
            <Separator Width="1" Margin="4,6" Background="{DynamicResource AppMuted}"/>
            <CheckBox Content="Show Hidden"
                      IsChecked="{Binding Panel.ShowHiddenFiles}"
                      Foreground="{DynamicResource AppForeground}"
                      VerticalAlignment="Center"
                      Margin="10,0"/>
            <Separator Width="1" Margin="4,6" Background="{DynamicResource AppMuted}"/>
            <Button Content="Terminal" Command="{Binding ShowDetachedTerminalWindowCommand}" Style="{StaticResource ToolbarButton}" Padding="10,4" FontSize="12" ToolTip="Open Terminal (F12)"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Explorer Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource AppSurface}">
                <TabControl SelectedIndex="{Binding SelectedSidebarSectionIndex}"
                            Background="{DynamicResource AppSurface}"
                            BorderThickness="0">
                    <TabItem Header="Explorer">
                        <TreeView x:Name="FileTree"
                                  ItemsSource="{Binding Tree.Roots}"
                                  Background="Transparent"
                                  Foreground="{DynamicResource AppForeground}"
                                  BorderThickness="0"
                                  AllowDrop="True"
                                  DragOver="FileTree_DragOver"
                                  Drop="FileTree_Drop"
                                  SelectedItemChanged="FileTree_SelectedItemChanged">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppForeground}"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                    <Setter Property="ContextMenu" Value="{StaticResource TreeFolderMenu}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </TabItem>

                    <TabItem Header="Search">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                            <StackPanel Margin="12">
                                <TextBlock Text="Search this location" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AppForeground}"/>
                                <TextBlock Text="{Binding CurrentPath}" Margin="0,4,0,12" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}"/>

                                <TextBlock Text="Name Pattern" Foreground="{DynamicResource AppMuted}"/>
                                <TextBox x:Name="SearchBox"
                                         Text="{Binding Search.Pattern, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,10"
                                         Padding="6,4"
                                         Foreground="{DynamicResource AppForeground}"
                                         Background="{DynamicResource AppBackground}"
                                         BorderBrush="{DynamicResource AppMuted}"/>

                                <TextBlock Text="Name Match Mode" Foreground="{DynamicResource AppMuted}"/>
                                <ComboBox SelectedItem="{Binding Search.NameMode}"
                                          ItemsSource="{Binding Source={StaticResource SearchNameModes}}"
                                          Style="{StaticResource SidebarComboBoxStyle}"
                                          Margin="0,4,0,10"/>

                                <TextBlock Text="Target Type" Foreground="{DynamicResource AppMuted}"/>
                                <ComboBox SelectedItem="{Binding Search.TargetType}"
                                          ItemsSource="{Binding Source={StaticResource SearchTargetTypes}}"
                                          Style="{StaticResource SidebarComboBoxStyle}"
                                          Margin="0,4,0,10"
                                          />

                                <CheckBox Content="Search subfolders recursively"
                                          IsChecked="{Binding Search.Recursive}"
                                          Margin="0,0,0,10"
                                          Foreground="{DynamicResource AppForeground}"/>

                                <TextBlock Text="Extensions" Foreground="{DynamicResource AppMuted}"/>
                                <TextBox Text="{Binding Search.Extensions, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,2"
                                         Padding="6,4"
                                         Foreground="{DynamicResource AppForeground}"
                                         Background="{DynamicResource AppBackground}"
                                         BorderBrush="{DynamicResource AppMuted}"/>
                                <TextBlock Text="Comma-separated, for example: txt,pdf,log"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource AppMuted}"
                                           FontSize="11"/>

                                <TextBlock Text="Attributes" Foreground="{DynamicResource AppMuted}"/>
                                <WrapPanel Margin="0,4,0,10">
                                    <CheckBox Content="Read-only" IsChecked="{Binding Search.AttributeReadOnly}" Margin="0,0,12,6" Foreground="{DynamicResource AppForeground}"/>
                                    <CheckBox Content="Hidden" IsChecked="{Binding Search.AttributeHidden}" Margin="0,0,12,6" Foreground="{DynamicResource AppForeground}"/>
                                    <CheckBox Content="Archive" IsChecked="{Binding Search.AttributeArchive}" Margin="0,0,12,6" Foreground="{DynamicResource AppForeground}"/>
                                    <CheckBox Content="System" IsChecked="{Binding Search.AttributeSystem}" Margin="0,0,12,6" Foreground="{DynamicResource AppForeground}"/>
                                </WrapPanel>

                                <TextBlock Text="Size Filters (MB)" Foreground="{DynamicResource AppMuted}"/>
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Above" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <TextBox Text="{Binding Search.AboveSize}"
                                                 IsEnabled="{Binding Search.IsSizeRangeEnabled}"
                                                 Padding="6,4"
                                                 Foreground="{DynamicResource AppForeground}"
                                                 Background="{DynamicResource AppBackground}"
                                                 BorderBrush="{DynamicResource AppMuted}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Exact" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <TextBox Text="{Binding Search.ExactSize}"
                                                 IsEnabled="{Binding Search.IsSizeExactEnabled}"
                                                 Padding="6,4"
                                                 Foreground="{DynamicResource AppForeground}"
                                                 Background="{DynamicResource AppBackground}"
                                                 BorderBrush="{DynamicResource AppMuted}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Below" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <TextBox Text="{Binding Search.BelowSize}"
                                                 IsEnabled="{Binding Search.IsSizeRangeEnabled}"
                                                 Padding="6,4"
                                                 Foreground="{DynamicResource AppForeground}"
                                                 Background="{DynamicResource AppBackground}"
                                                 BorderBrush="{DynamicResource AppMuted}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Created Date" Foreground="{DynamicResource AppMuted}"/>
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="From" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <DatePicker SelectedDate="{Binding Search.CreatedFrom}"
                                                    IsEnabled="{Binding Search.IsCreatedRangeEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="On" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <DatePicker SelectedDate="{Binding Search.CreatedOn}"
                                                    IsEnabled="{Binding Search.IsCreatedExactEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="To" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <DatePicker SelectedDate="{Binding Search.CreatedTo}"
                                                    IsEnabled="{Binding Search.IsCreatedRangeEnabled}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Modified Date" Foreground="{DynamicResource AppMuted}"/>
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="From" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <DatePicker SelectedDate="{Binding Search.ModifiedFrom}"
                                                    IsEnabled="{Binding Search.IsModifiedRangeEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="On" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <DatePicker SelectedDate="{Binding Search.ModifiedOn}"
                                                    IsEnabled="{Binding Search.IsModifiedExactEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="To" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <DatePicker SelectedDate="{Binding Search.ModifiedTo}"
                                                    IsEnabled="{Binding Search.IsModifiedRangeEnabled}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Accessed Date" Foreground="{DynamicResource AppMuted}"/>
                                <Grid Margin="0,4,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="From" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <DatePicker SelectedDate="{Binding Search.AccessedFrom}"
                                                    IsEnabled="{Binding Search.IsAccessedRangeEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="On" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <DatePicker SelectedDate="{Binding Search.AccessedOn}"
                                                    IsEnabled="{Binding Search.IsAccessedExactEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="To" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                        <DatePicker SelectedDate="{Binding Search.AccessedTo}"
                                                    IsEnabled="{Binding Search.IsAccessedRangeEnabled}"/>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel>
                                    <Button Content="Search"
                                            Command="{Binding Search.StartSearchCommand}"
                                            CommandParameter="{Binding CurrentPath}"
                                            Padding="12,5"
                                            Margin="0,0,8,0"
                                            Background="{DynamicResource AppSelection}"
                                            Foreground="{DynamicResource AppSelectionText}"/>
                                    <Button Content="Cancel"
                                            Command="{Binding Search.CancelSearchCommand}"
                                            Padding="12,5"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding Search.IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Content="Clear Filters"
                                            Command="{Binding Search.ClearFiltersCommand}"
                                            Padding="12,5"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource AppSurface}"/>

            <!-- File List Panel -->
            <Grid Grid.Column="2" Background="{DynamicResource AppBackground}">
                <ListView x:Name="FileList"
                          ItemsSource="{Binding Panel.Entries}"
                          SelectedItem="{Binding Panel.SelectedEntry, Mode=TwoWay}"
                          Background="Transparent"
                          Foreground="{DynamicResource AppForeground}"
                          BorderThickness="0"
                          AllowDrop="True"
                          MouseDoubleClick="FileList_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                          PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                          MouseMove="FileList_MouseMove"
                          DragOver="FileList_DragOver"
                          Drop="FileList_Drop"
                          ContextMenu="{StaticResource EmptySpaceMenu}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="24">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="16" Height="16"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding Type}"/>
                            <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}"/>
                            <GridViewColumn Header="Date Modified" Width="140" DisplayMemberBinding="{Binding DateModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="ContextMenu" Value="{StaticResource FolderMenu}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                    <Setter Property="ContextMenu" Value="{StaticResource FileMenu}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Empty state overlay -->
                <TextBlock Text="This folder is empty"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMuted}"
                           FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Panel.IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Error state overlay -->
                <TextBlock Text="{Binding Panel.ErrorMessage}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMuted}"
                           FontSize="13" TextWrapping="Wrap" MaxWidth="400">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Panel.ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3" Background="{DynamicResource AppSurface}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppMuted}"
                       Visibility="{Binding Panel.IsCopying, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StatusBarItem>
                    <ProgressBar Width="200" Height="14" Minimum="0" Maximum="1" Value="{Binding Panel.CopyProgress}"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="Copying files..." Foreground="{DynamicResource AppForeground}" FontSize="12" Margin="5,0,0,0"/>
                </StatusBarItem>
        </StatusBar>

        <!-- Terminal -->
        <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource AppSurface}">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Palette.IsVisible}" Value="True"/>
                                <Condition Binding="{Binding IsTerminalDetached}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>
        <localViews:CommandPaletteView Grid.Row="4"
                                       DataContext="{Binding Palette}">
            <localViews:CommandPaletteView.Style>
                <Style TargetType="localViews:CommandPaletteView">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Palette.IsVisible}" Value="True"/>
                                <Condition Binding="{Binding IsTerminalDetached}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </localViews:CommandPaletteView.Style>
        </localViews:CommandPaletteView>
    </Grid>
</Window>
